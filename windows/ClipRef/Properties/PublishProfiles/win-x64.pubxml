<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained, single-file publish profile for the ClipRef tray app (win-x64).

  Mirrors the macOS .app distribution: the end user installs nothing — the .NET 8
  Desktop runtime is bundled into one ClipRef.exe. Compression roughly halves the
  bundle for a small one-time startup cost, acceptable for a tray app launched once
  at login. Trimming is intentionally left off: WinForms relies on reflection.

  The self-contained WindowsDesktop runtime ships native libraries (WPF's
  D3DCompiler/PenImc/PresentationNative/wpfgfx + vcruntime) that single-file does
  not embed by default. IncludeNativeLibrariesForSelfExtract bundles them into the
  exe too, so the deliverable is genuinely one ClipRef.exe; they self-extract to a
  content-hashed temp dir on first launch and are reused thereafter.

  DebugType=none suppresses the .pdb for this release publish, so the publish
  folder contains exactly one file — ClipRef.exe. Debug/test builds keep their
  symbols because this lives in the profile, not the csproj.

  Publish with:  dotnet publish windows/ClipRef/ClipRef.csproj -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
